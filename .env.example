# Obrigatória: endereço da central (VPS do admin), ex.: https://mpw.exemplo.com
CENTRAL_API_URL=

# Registry de onde as imagens são baixadas (só mude se o admin pedir)
IMAGE_REGISTRY=ghcr.io/ayresigo

# Versão das imagens: stable acompanha a última release; use uma versão (ex.: 1.2.0) para fixar
MPW_TAG=stable

# true = aplica atualizações sozinho; false = só avisa no painel (dá para mudar depois pela UI)
AUTO_UPDATE=true
