# Obrigatória: endereço da central (VPS do admin), ex.: https://mpw.exemplo.com
CENTRAL_API_URL=

# Registry de onde as imagens são baixadas (só mude se o admin pedir)
IMAGE_REGISTRY=ghcr.io/ayresigo

# Versão das imagens. stable acompanha a última release.
# Para fixar ou voltar para uma versão (ex.: 1.2.0): desligue antes a "Atualização automática"
# em Configurações (senão o painel volta sozinho para a mais nova) e depois rode
# `docker compose pull && docker compose up -d`. Nunca rode só `docker compose up -d` depois de
# mudar este arquivo.
MPW_TAG=stable

# true = aplica atualizações sozinho; false = só avisa no painel. Depois que você mexer na opção
# pela UI, vale o que foi salvo na UI e este valor é ignorado.
AUTO_UPDATE=true

# Opcional: outros nomes pelos quais você abre o painel, separados por vírgula (ex.: meupc.lan).
# Por padrão só localhost, 127.0.0.1 e [::1] são aceitos.
ALLOWED_HOSTS=
