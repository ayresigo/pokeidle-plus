FROM node:22-slim AS deps
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc tsconfig.base.json ./
COPY apps/central-api/package.json apps/central-api/
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY apps/central-api apps/central-api
RUN DATABASE_URL="postgresql://localhost:5432/build" pnpm --filter central-api db:generate && pnpm --filter central-api build

FROM node:22-slim AS runtime
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
RUN corepack enable
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app ./
WORKDIR /app/apps/central-api
ARG VERSION=dev
ENV APP_VERSION=$VERSION
EXPOSE 8080
CMD ["sh", "-c", "pnpm exec prisma migrate deploy && pnpm db:seed && node dist/server.js"]
